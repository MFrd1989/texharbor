POSTGRES_DB=texharbor
POSTGRES_USER=texharbor
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://texharbor:change-me@db:5432/texharbor
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
POSTGRES_VOLUME=texharbor-postgres-data
PROJECT_VOLUME=texharbor-project-storage
COMPILER_IMAGE=texharbor-compiler:latest
APP_IMAGE=texharbor-app:latest
WORKER_IMAGE=texharbor-worker:latest

# Optional Google Drive backups. Create a Web application OAuth client and add:
# http://localhost:3000/api/cloud/google/callback (or PUBLIC_ORIGIN + this path)
# as an authorized redirect URI. The secret remains server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
